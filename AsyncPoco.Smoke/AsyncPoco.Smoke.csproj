<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Smoke test for the net9 build (AsyncPocoCore). No DB server needed: uses in-memory SQLite.
    Run:  dotnet run (with -p or /project) pointing at AsyncPoco.Smoke
    Exit code 0 = all checks passed. See docs/PORTING-NET9.md.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AsyncPocoCore\AsyncPocoCore.csproj" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" />
  </ItemGroup>

</Project>
