<Project Sdk="Microsoft.NET.Sdk">

  <!--
    AsyncPoco (BambooMod): one project, two targets.
      net48   - consumed by X:\P5\AsyncPocoPioneer and X:\P5\Bamboo.Commenter (project references to this file).
      net10.0 - modern build; verified by ../AsyncPoco.Smoke.
    Output: bin\<Config>\<tfm>\AsyncPoco.dll. See docs/PORTING-NET9.md.
  -->

  <PropertyGroup>
    <TargetFrameworks>net48;net10.0</TargetFrameworks>
    <OutputType>Library</OutputType>
    <AssemblyName>AsyncPoco</AssemblyName>
    <RootNamespace>AsyncPoco</RootNamespace>
    <Configurations>CMSWebConsole-Only;Debug;Release</Configurations>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- Properties/AssemblyInfo.cs carries the version for both targets. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- Linq/ is dead code and AsyncPoco.cs is the old single-file bundle; never compile either. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);Linq\**;AsyncPoco.cs</DefaultItemExcludes>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- ConfigurationManager.ConnectionStrings for Database(string connectionStringName). -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System.configuration" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="AsyncPoco.nuspec">
      <SubType>Designer</SubType>
    </None>
    <None Update="T4 Templates\Database.tt">
      <LastGenOutput>Database.cs</LastGenOutput>
    </None>
    <None Update="T4 Templates\StoredProcedures.tt">
      <LastGenOutput>StoredProcedures.cs</LastGenOutput>
    </None>
  </ItemGroup>
  <ItemGroup>
    <Service Include="{508349B6-6B84-4DF5-91F0-309BEEBAD82D}" />
  </ItemGroup>

</Project>
