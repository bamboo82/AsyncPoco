<Project Sdk="Microsoft.NET.Sdk">

  <!--
    AsyncPocoCore: the .NET 9 build of AsyncPoco.
    Source files are a mirror of ../AsyncPoco (net48). See docs/PORTING-NET9.md for the sync procedure.
  -->

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>AsyncPoco</AssemblyName>
    <RootNamespace>AsyncPoco</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- Properties/AssemblyInfo.cs carries the version; keep it authoritative for both builds. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- Linq/ is legacy and excluded on the net48 side too; keep it out of the net9 build if it ever gets copied in. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);Linq\**;AsyncPoco.cs</DefaultItemExcludes>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DocumentationFile>bin\Release\AsyncPoco.xml</DocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- ConfigurationManager.ConnectionStrings support for Database(string connectionStringName). -->
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="AsyncPoco.nuspec">
      <SubType>Designer</SubType>
    </None>
    <None Update="T4 Templates\Database.tt">
      <LastGenOutput>Database.cs</LastGenOutput>
    </None>
    <None Update="T4 Templates\StoredProcedures.tt">
      <LastGenOutput>StoredProcedures.cs</LastGenOutput>
    </None>
  </ItemGroup>

</Project>
